{
  "name": "@line-item-watch/ui-assurance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test --project=deterministic",
    "test:visual": "playwright test --project=visual",
    "test:config": "node --import tsx --test tests/config.test.ts tests/evidence.test.ts",
    "test:staging": "playwright test --project=staging",
    "test:production": "playwright test --project=production",
    "synthetic": "node scripts/run-synthetic.mjs"
  },
  "dependencies": {
    "@playwright/test": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
